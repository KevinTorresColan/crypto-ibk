{
  "name": "ibk-crypto",
  "version": "1.0.0",
  "description": "Librería de utilidades TypeScript",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/composition-root/container/index.d.ts",
